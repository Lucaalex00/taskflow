# Copy to `.env` (same folder) and edit anything you like — docker compose picks it up
# automatically. Every value here is optional: with no .env file at all, the defaults baked
# into docker-compose.yml produce exactly the same demo stack.
#
#   cp .env.example .env

# --- Ports on your machine -------------------------------------------------
# Change these if something else already listens there (a local Postgres on 5432 is the
# usual collision). Only the host side moves; the containers keep talking on their own ports.
WEB_PORT=4200
API_PORT=5080
POSTGRES_PORT=5432

# --- Database ---------------------------------------------------------------
POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow

# --- Authentication ----------------------------------------------------------
# JWT signing key. Must be 32+ characters. The default is a public, well-known demo value —
# the API refuses to start with it when ASPNETCORE_ENVIRONMENT=Production.
# Generate one:  openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-in-any-real-deployment-32chars+
JWT_EXPIRY_MINUTES=1440

# Per-IP throttle on /api/auth/login and /api/users (registration).
AUTH_RATE_LIMIT_PERMITS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# --- Demo data ----------------------------------------------------------------
# Seeds a demo workspace on first start (only ever runs against an empty database):
# demo@taskflow.dev (owner) + teammate@taskflow.dev (member), a populated board, and enough
# overdue/in-progress load to make the anomaly detector raise a real alert within a cycle.
# Set to false if you'd rather start from an empty instance.
SEED_DEMO=true
SEED_PASSWORD=Demo-password-2026

# Hours before the demo workspace is wiped and rebuilt from scratch — including any accounts
# and boards visitors created. 168 = weekly, which keeps a demo link you've shared looking the
# way it should without you having to remember. Set to 0 to disable and keep your data.
SEED_RESET_INTERVAL_HOURS=168

# --- Frontend -----------------------------------------------------------------
# Internal address nginx proxies /api and /hubs to. Only needs changing outside compose.
API_UPSTREAM=api:8080

# --- Workload monitor -----------------------------------------------------------
# Seconds between load snapshots + alert-rule evaluations. Turn it down to watch alerts
# appear live while exploring; turn it up to keep the logs quiet.
LOAD_MONITOR_INTERVAL_SECONDS=20

# --- Runtime -----------------------------------------------------------------
# Development exposes Swagger at /swagger and logs at Debug level. Use Production for a
# real deployment (Swagger off, Information logs, weak-JWT-secret startup check enforced).
ASPNETCORE_ENVIRONMENT=Development

# --- Resource caps ---------------------------------------------------------------
POSTGRES_CPUS=1.0
POSTGRES_MEMORY=512M
API_CPUS=1.0
API_MEMORY=512M
WEB_CPUS=0.5
WEB_MEMORY=128M

# --- Prebuilt images (docker-compose.prebuilt.yml only) ------------------------------
# Which published image tag to pull instead of building from source.
IMAGE_REGISTRY=ghcr.io/lucaalex00/taskflow
IMAGE_TAG=latest
