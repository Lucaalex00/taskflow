# Rendered at container start by the nginx image's entrypoint, which runs envsubst over
# every *.template in /etc/nginx/templates. Only API_UPSTREAM is substituted (see
# NGINX_ENVSUBST_FILTER in Dockerfile.frontend), so nginx's own $uri/$host/$http_upgrade
# variables below are left exactly as written.
#
# Under docker compose the default (api:8080) is the API service's name on the compose
# network. On a hosting platform, set API_UPSTREAM to whatever internal address that
# platform gives the API container — see docs/deploying.md.
server {
    listen 8080;
    listen [::]:8080;
    server_name localhost;
    root /usr/share/nginx/html;
    index index.html;

    # Defensive headers on every response. The CSP is scoped to what the Angular app actually
    # loads: same-origin scripts/XHR/WebSocket, Google Fonts (the only third-party origin),
    # inline styles (Angular's component styles land in the main stylesheet, but this stays
    # permissive enough not to fight the framework over it), and the two GitHub image hosts the
    # in-app docs panel's rendered README points at (shields.io badges, raw.githubusercontent.com
    # screenshots — see shared/docs-panel).
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://img.shields.io https://raw.githubusercontent.com https://github.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Angular client-side routing: any unknown path falls back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API calls to the backend container so the browser only ever talks
    # to one origin (avoids CORS entirely in the Docker Compose demo).
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # SignalR needs WebSocket upgrade headers forwarded explicitly.
    location /hubs/ {
        proxy_pass http://${API_UPSTREAM}/hubs/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }

    location = /health {
        proxy_pass http://${API_UPSTREAM}/health;
    }
}
