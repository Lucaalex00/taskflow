# --- Build stage -----------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /src

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ .
RUN npm run build -- --configuration production

# --- Runtime stage -----------------------------------------------------------
# nginx-unprivileged: same nginx image, but pre-configured to run as a non-root user
# and listen on an unprivileged port (8080) — avoids needing a root process in the
# container at all, unlike the stock nginx image which starts its master process as root.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime

# Dropped in /etc/nginx/templates rather than conf.d: the image's entrypoint runs envsubst
# over templates at start-up, which is what lets the API's address be set per environment
# instead of baked into the image (docker compose vs. a hosting platform — see
# docs/deploying.md). The filter keeps envsubst away from nginx's own $variables.
COPY docker/default.conf.template /etc/nginx/templates/default.conf.template
ENV API_UPSTREAM=api:8080 \
    NGINX_ENVSUBST_FILTER=^API_UPSTREAM$

# Angular 19 build output lands under dist/frontend/browser.
COPY --from=build /src/dist/frontend/browser /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=5 \
    CMD wget -qO- http://127.0.0.1:8080 || exit 1
